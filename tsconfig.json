{
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "@ezpg/native-ui": [
        "./packages/native-ui/src/index"
      ],
      "@ezpg/native-ui/charts": [
        "./packages/native-ui/src/charts"
      ],
      "@ezpg/native-ui/sortable": [
        "./packages/native-ui/src/sortable"
      ]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": [
      "ezpg-native-ui-source",
      "react-native-strict-api"
    ],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "jest",
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "exclude": [
    "**/node_modules",
    "**/lib"
  ]
}
