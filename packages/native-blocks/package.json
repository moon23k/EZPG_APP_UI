{
  "name": "@ezpg/native-blocks",
  "version": "0.0.0",
  "description": "EZPG domain blocks built on @ezpg/native-ui",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "ezpg-native-blocks-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./charts": {
      "ezpg-native-blocks-source": "./src/charts.tsx",
      "types": "./lib/typescript/src/charts.d.ts",
      "default": "./lib/module/charts.js"
    },
    "./sortable": {
      "ezpg-native-blocks-source": "./src/sortable.tsx",
      "types": "./lib/typescript/src/sortable.d.ts",
      "default": "./lib/module/sortable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/*.stories.tsx",
    "!**/__stories__",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "sideEffects": false,
  "scripts": {
    "prepare": "bob build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon23k/EZPG_APP_UI.git",
    "directory": "packages/native-blocks"
  },
  "author": "moon23k <d.moon23k@gmail.com> (https://github.com/moon23k)",
  "license": "MIT",
  "peerDependencies": {
    "@ezpg/native-ui": "workspace:^",
    "react": ">=19.0.0",
    "react-native": ">=0.82.0",
    "react-native-gesture-handler": ">=2.28.0",
    "react-native-reanimated": ">=4.5.5",
    "react-native-sortables": ">=1.10.0",
    "react-native-svg": ">=15.0.0",
    "react-native-worklets": ">=0.10.0"
  },
  "devDependencies": {
    "@ezpg/native-ui": "workspace:^",
    "react-native-builder-bob": "^0.43.2",
    "typescript": "^6.0.3"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/{__tests__,__fixtures__,__mocks__,__stories__}/**,**/*.stories.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-sortables": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
