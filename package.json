{
  "name": "ezpg-native-ui-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "example": "yarn workspace @ezpg/native-ui-example",
    "build": "yarn workspaces foreach -A --topological-dev --exclude @ezpg/native-ui-example run prepare",
    "clean": "del-cli example/android/build example/android/app/build example/ios/build \"packages/*/lib\"",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "release": "yarn build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@storybook/react-native-web-vite": "10.6.3",
    "@testing-library/react-native": "^14",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.2",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "storybook": "10.6.3",
    "test-renderer": "~1.2.0",
    "typescript": "^6.0.3",
    "vite": "^8"
  },
  "packageManager": "yarn@4.11.0",
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
