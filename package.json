{
  "name": "@ezpg/native-ui",
  "version": "0.0.0",
  "description": "EZPG partner app UI components",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "ezpg-native-ui-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./charts": {
      "ezpg-native-ui-source": "./src/charts.tsx",
      "types": "./lib/typescript/src/charts.d.ts",
      "default": "./lib/module/charts.js"
    },
    "./sortable": {
      "ezpg-native-ui-source": "./src/sortable.tsx",
      "types": "./lib/typescript/src/sortable.d.ts",
      "default": "./lib/module/sortable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/*.stories.tsx",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @ezpg/native-ui-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "release": "yarn prepare && changeset publish"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "ui",
    "design-system",
    "components",
    "ezpg"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon23k/EZPG_APP_UI.git"
  },
  "author": "moon23k <d.moon23k@gmail.com> (https://github.com/moon23k)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/moon23k/EZPG_APP_UI/issues"
  },
  "homepage": "https://github.com/moon23k/EZPG_APP_UI#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^3",
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@storybook/react-native-web-vite": "10.6.3",
    "@testing-library/react-native": "^14",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0",
    "del-cli": "^7.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.2",
    "react-native-web": "0.21.4",
    "storybook": "10.6.3",
    "test-renderer": "~1.2.0",
    "turbo": "^2.10.8",
    "typescript": "^6.0.3",
    "vite": "^8"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.79.0",
    "react-native-svg": ">=15.0.0",
    "react-native-gesture-handler": ">=2.20.0",
    "react-native-reanimated": ">=3.16.0",
    "react-native-worklets": ">=0.5.0"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.11.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "{**/{__tests__,__fixtures__,__mocks__}/**,**/*.stories.tsx}"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.63.1"
  },
  "peerDependenciesMeta": {
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  }
}
